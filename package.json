{
  "name": "voice-calibration",
  "version": "2.7.0",
  "description": "Local ElevenLabs voice calibration UI with dry-run, approval, idempotence and canonical WPM publication.",
  "type": "module",
  "bin": {
    "voice-calibration": "dist/calibration-cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "biome ci --formatter-enabled=false .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/build-calibration-ui.mjs",
    "test": "node --test --test-reporter=spec test/calibration-*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=dist/calibration/**/*.js --test-coverage-lines=80 --test-coverage-functions=80 --test-reporter=spec",
    "dev": "node --import tsx src/calibration-cli.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "voice-calibration",
    "elevenlabs",
    "calibration",
    "wpm",
    "cli"
  ],
  "author": "David Beles <davidb-2107@users.noreply.github.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/node": "^25.6.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
